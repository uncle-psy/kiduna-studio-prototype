{
  "card.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "card.schema.json",
    "title": "Oracle Card",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "ordinal",
      "title",
      "aliases",
      "class",
      "className",
      "domains",
      "primaryDomain",
      "secondaryDomains",
      "domainNames",
      "materialModes",
      "epistemicLayers",
      "sources",
      "origin",
      "culturalHistory",
      "essence",
      "archetype",
      "gift",
      "shadow",
      "meanings",
      "divination",
      "guidance",
      "integration",
      "question",
      "storySeed",
      "gameRoles",
      "polarities",
      "relationships",
      "relationshipRequirements",
      "visual",
      "safety",
      "research",
      "version"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "ordinal": {
        "type": "integer",
        "minimum": 1
      },
      "title": {
        "type": "string",
        "minLength": 2
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "class": {
        "enum": [
          "forces",
          "cosmologies",
          "beings",
          "worlds",
          "technologies",
          "artifacts",
          "factions",
          "programs",
          "systems",
          "events",
          "states",
          "myths",
          "hypotheses"
        ]
      },
      "className": {
        "type": "string",
        "minLength": 1
      },
      "domains": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "uniqueItems": true,
        "items": {
          "enum": [
            "origin-lineage",
            "reality-ontology",
            "intelligence-otherness",
            "contact-communication",
            "mind-consciousness",
            "memory-identity",
            "body-evolution",
            "technology-infrastructure",
            "time-causality",
            "civilization-ecology",
            "power-control",
            "liberation-transcendence"
          ]
        }
      },
      "primaryDomain": {
        "enum": [
          "origin-lineage",
          "reality-ontology",
          "intelligence-otherness",
          "contact-communication",
          "mind-consciousness",
          "memory-identity",
          "body-evolution",
          "technology-infrastructure",
          "time-causality",
          "civilization-ecology",
          "power-control",
          "liberation-transcendence"
        ]
      },
      "secondaryDomains": {
        "type": "array",
        "maxItems": 2,
        "uniqueItems": true,
        "items": {
          "enum": [
            "origin-lineage",
            "reality-ontology",
            "intelligence-otherness",
            "contact-communication",
            "mind-consciousness",
            "memory-identity",
            "body-evolution",
            "technology-infrastructure",
            "time-causality",
            "civilization-ecology",
            "power-control",
            "liberation-transcendence"
          ]
        }
      },
      "domainNames": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "materialModes": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "established-science",
            "emerging-science",
            "speculative-science",
            "science-fiction",
            "mythology",
            "esoteric-tradition",
            "experiential-report",
            "ufology-disclosure-lore",
            "conspiracy-mythology",
            "political-mythology",
            "internet-folklore",
            "spiritual-cosmology",
            "original-synthesis"
          ]
        }
      },
      "epistemicLayers": {
        "type": "array",
        "minItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "layer",
            "materialModes",
            "status",
            "statement",
            "sourceIds"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "layer": {
              "type": "string",
              "minLength": 1
            },
            "materialModes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "established-science",
                  "emerging-science",
                  "speculative-science",
                  "science-fiction",
                  "mythology",
                  "esoteric-tradition",
                  "experiential-report",
                  "ufology-disclosure-lore",
                  "conspiracy-mythology",
                  "political-mythology",
                  "internet-folklore",
                  "spiritual-cosmology",
                  "original-synthesis"
                ]
              }
            },
            "status": {
              "enum": [
                "well-established",
                "documented-historical",
                "active-research",
                "plausible-speculation",
                "contested",
                "unverified",
                "contradicted-by-evidence",
                "experiential-only",
                "fictional",
                "symbolic",
                "not-applicable"
              ]
            },
            "statement": {
              "type": "string",
              "minLength": 20
            },
            "sourceIds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              }
            }
          }
        }
      },
      "sources": {
        "type": "array",
        "minItems": 2,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      },
      "origin": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "summary",
          "provenanceRule",
          "traditionCare"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 20
          },
          "provenanceRule": {
            "type": "string",
            "minLength": 20
          },
          "traditionCare": {
            "type": "string",
            "minLength": 20
          }
        }
      },
      "culturalHistory": {
        "type": "string",
        "minLength": 20
      },
      "essence": {
        "type": "string",
        "minLength": 10
      },
      "archetype": {
        "type": "string",
        "minLength": 1
      },
      "gift": {
        "type": "string",
        "minLength": 5
      },
      "shadow": {
        "type": "string",
        "minLength": 5
      },
      "meanings": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "psychological",
          "social",
          "spiritual",
          "technological",
          "political"
        ],
        "properties": {
          "psychological": {
            "type": "string",
            "minLength": 20
          },
          "social": {
            "type": "string",
            "minLength": 20
          },
          "spiritual": {
            "type": "string",
            "minLength": 20
          },
          "technological": {
            "type": "string",
            "minLength": 20
          },
          "political": {
            "type": "string",
            "minLength": 20
          }
        }
      },
      "divination": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signal",
          "upright",
          "shadow",
          "positionPrompts"
        ],
        "properties": {
          "signal": {
            "type": "string",
            "minLength": 20
          },
          "upright": {
            "type": "string",
            "minLength": 20
          },
          "shadow": {
            "type": "string",
            "minLength": 20
          },
          "positionPrompts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "origin",
              "present",
              "threshold",
              "integration"
            ],
            "properties": {
              "origin": {
                "type": "string",
                "minLength": 1
              },
              "present": {
                "type": "string",
                "minLength": 1
              },
              "threshold": {
                "type": "string",
                "minLength": 1
              },
              "integration": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "guidance": {
        "type": "string",
        "minLength": 20
      },
      "integration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "practice",
          "boundary",
          "completionSignal"
        ],
        "properties": {
          "practice": {
            "type": "string",
            "minLength": 20
          },
          "boundary": {
            "type": "string",
            "minLength": 10
          },
          "completionSignal": {
            "type": "string",
            "minLength": 20
          }
        }
      },
      "question": {
        "type": "string",
        "minLength": 1
      },
      "storySeed": {
        "type": "string",
        "minLength": 20
      },
      "gameRoles": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      },
      "polarities": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      },
      "relationships": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      },
      "relationshipRequirements": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "minimumDegree",
          "minimumEdgeFamilies",
          "requireCrossDomain",
          "requireSourcedEdge",
          "requireOriginalSynthesisEdge",
          "status"
        ],
        "properties": {
          "minimumDegree": {
            "type": "integer",
            "minimum": 0
          },
          "minimumEdgeFamilies": {
            "type": "integer",
            "minimum": 0
          },
          "requireCrossDomain": {
            "type": "boolean"
          },
          "requireSourcedEdge": {
            "type": "boolean"
          },
          "requireOriginalSynthesisEdge": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "actualDegree": {
            "type": "integer",
            "minimum": 0
          },
          "actualEdgeFamilies": {
            "type": "integer",
            "minimum": 0
          },
          "edgeFamilies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "hasCrossDomain": {
            "type": "boolean"
          },
          "hasSourcedEdge": {
            "type": "boolean"
          },
          "hasOriginalSynthesisEdge": {
            "type": "boolean"
          }
        }
      },
      "visual": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alt",
          "centralMotif",
          "borderGrammar",
          "accent",
          "material",
          "typography",
          "prohibited"
        ],
        "properties": {
          "alt": {
            "type": "string",
            "minLength": 1
          },
          "centralMotif": {
            "type": "string",
            "minLength": 1
          },
          "borderGrammar": {
            "type": "string",
            "minLength": 1
          },
          "accent": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "material": {
            "type": "string",
            "minLength": 1
          },
          "typography": {
            "type": "string",
            "minLength": 1
          },
          "prohibited": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "safety": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "flags",
          "boundaries",
          "use"
        ],
        "properties": {
          "level": {
            "enum": [
              "standard",
              "reviewed",
              "high-attention"
            ]
          },
          "flags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "boundaries": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "use": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "research": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "confidence",
          "editorialStatus",
          "sourceCoverage",
          "contextualSourceCoverage",
          "contextualSourceId",
          "unsourced",
          "sourceGap",
          "openQuestions",
          "nextReview"
        ],
        "properties": {
          "confidence": {
            "type": "string",
            "minLength": 1
          },
          "editorialStatus": {
            "type": "string",
            "minLength": 1
          },
          "sourceCoverage": {
            "type": "integer",
            "minimum": 0
          },
          "contextualSourceCoverage": {
            "type": "integer",
            "minimum": 0
          },
          "contextualSourceId": {
            "type": [
              "string",
              "null"
            ]
          },
          "unsourced": {
            "type": "boolean"
          },
          "sourceGap": {
            "type": [
              "string",
              "null"
            ]
          },
          "openQuestions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "nextReview": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "version": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "status",
          "dated",
          "schema",
          "contentHash"
        ],
        "properties": {
          "number": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "dated": {
            "type": "string",
            "format": "date"
          },
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "contentHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}$"
          }
        }
      }
    }
  },
  "relationship.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "relationship.schema.json",
    "title": "Typed Relationship",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "type",
      "relationship",
      "family",
      "directionality",
      "source",
      "target",
      "label",
      "rationale",
      "basis",
      "confidence",
      "confidenceLabel",
      "derivation",
      "reviewStatus",
      "assertiveness",
      "substantive",
      "provenance"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "type": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "relationship": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "family": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "directionality": {
        "enum": [
          "directed",
          "symmetric"
        ]
      },
      "source": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "target": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "label": {
        "type": "string",
        "minLength": 1
      },
      "rationale": {
        "type": "string",
        "minLength": 20
      },
      "basis": {
        "enum": [
          "sourced",
          "original-synthesis"
        ]
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "confidenceLabel": {
        "enum": [
          "source-guided",
          "high",
          "editorial"
        ]
      },
      "derivation": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "specificationId"
            ],
            "properties": {
              "kind": {
                "const": "curated"
              },
              "specificationId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "ruleId",
              "features"
            ],
            "properties": {
              "kind": {
                "const": "rule"
              },
              "ruleId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "features": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "sourceIds": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                    }
                  },
                  "classId": {
                    "enum": [
                      "forces",
                      "cosmologies",
                      "beings",
                      "worlds",
                      "technologies",
                      "artifacts",
                      "factions",
                      "programs",
                      "systems",
                      "events",
                      "states",
                      "myths",
                      "hypotheses"
                    ]
                  },
                  "domainIds": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "origin-lineage",
                        "reality-ontology",
                        "intelligence-otherness",
                        "contact-communication",
                        "mind-consciousness",
                        "memory-identity",
                        "body-evolution",
                        "technology-infrastructure",
                        "time-causality",
                        "civilization-ecology",
                        "power-control",
                        "liberation-transcendence"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "lineageId",
              "step"
            ],
            "properties": {
              "kind": {
                "const": "lineage"
              },
              "lineageId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "step": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        ]
      },
      "reviewStatus": {
        "enum": [
          "reviewed",
          "rule-validated"
        ]
      },
      "assertiveness": {
        "enum": [
          "assertive",
          "literal-classification"
        ]
      },
      "substantive": {
        "type": "boolean"
      },
      "provenance": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "basis",
          "sourceIds",
          "note"
        ],
        "properties": {
          "kind": {
            "enum": [
              "sourced",
              "original-synthesis"
            ]
          },
          "basis": {
            "enum": [
              "sourced",
              "original-synthesis"
            ]
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "note": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    }
  },
  "lineage.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "lineage.schema.json",
    "title": "Lineage",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "thesis",
      "inquiryDomainId",
      "cardIds",
      "edgeIds",
      "missingCardNames",
      "reading"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "thesis": {
        "type": "string",
        "minLength": 20
      },
      "inquiryDomainId": {
        "enum": [
          "origin-lineage",
          "reality-ontology",
          "intelligence-otherness",
          "contact-communication",
          "mind-consciousness",
          "memory-identity",
          "body-evolution",
          "technology-infrastructure",
          "time-causality",
          "civilization-ecology",
          "power-control",
          "liberation-transcendence"
        ]
      },
      "cardIds": {
        "type": "array",
        "minItems": 2,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      },
      "edgeIds": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      },
      "missingCardNames": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "reading": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "forward",
          "reverse",
          "diagnostic"
        ],
        "properties": {
          "forward": {
            "type": "string",
            "minLength": 20
          },
          "reverse": {
            "type": "string",
            "minLength": 20
          },
          "diagnostic": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    }
  },
  "spread.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "spread.schema.json",
    "title": "Spread",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "cards",
      "purpose",
      "positions"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "cards": {
        "type": "integer",
        "minimum": 1
      },
      "purpose": {
        "type": "string",
        "minLength": 20
      },
      "positions": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
